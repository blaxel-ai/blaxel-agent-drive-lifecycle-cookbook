# Start from this file only when running the optional combined reference.
BL_WORKSPACE=your-workspace
BL_API_KEY=your-service-account-api-key
BL_REGION=us-was-1
BL_SANDBOX_IMAGE=your-pushed-image-id
BL_SANDBOX_TTL=1h
BL_MOUNT_PATH=/data

BL_MODEL_ENDPOINT=https://run.blaxel.ai/your-workspace/models/your-model/v1/chat/completions
APP_API_DOMAIN=api.example.com
APP_API_PATH=/v1/records

# Local recipe demonstration only. Replace ExampleHmacCredentialBroker with
# your application credential issuer before adapting this pattern.
APP_TOKEN_SIGNING_KEY=replace-with-at-least-32-random-characters

LIFECYCLE_DATABASE_URL=postgres://user:password@localhost:5432/agent_lifecycle
LIFECYCLE_OWNER_ID=orchestrator-1
CLEANUP_GRACE_PERIOD_MS=3600000
CLEANUP_BATCH_SIZE=100

# External orchestrator only. Blaxel-hosted workloads can use native telemetry.
OTEL_EXPORTER_OTLP_ENDPOINT=https://otel-collector.example.com
OTEL_EXPORTER_OTLP_HEADERS=authorization=Bearer%20replace-me
